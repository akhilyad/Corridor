# ---- Corridor app config (local dev) ----
# Generate with: openssl rand -base64 32  (or any long random string)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# SQLite database (default). Production: swap for a real Postgres URL.
DATABASE_URL="file:./dev.db"

# Where uploaded compliance documents are stored locally.
UPLOAD_DIR="./uploads"

# Public base URL (used for absolute links in email templates etc.)
APP_BASE_URL="http://localhost:3000"

# Stripe is OPTIONAL. Leave blank to run in mock/offline billing mode.
# When set, the platform invoices module can issue real Stripe Payment Links.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Node env
NODE_ENV="development"
